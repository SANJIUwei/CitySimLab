config_version=5

[application]
config/name="CitySimLab · 城市出行演示"
run/main_scene="res://CityView.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="CitySim.Godot"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.09, 0.11, 1)
